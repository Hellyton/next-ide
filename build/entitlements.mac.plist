<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions the app needs; applied to the app and every helper inside it. -->
<plist version="1.0">
<dict>
  <!-- V8 JIT (Electron main, renderers, utility processes). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- node-pty and koffi load native .node modules that are not signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice dictation (Swift helper + on-device speech recognition). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
